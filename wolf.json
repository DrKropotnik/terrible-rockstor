{
  "Wolf": {
    "description": "<p>Wolf is an open source streaming server for Moonlight that allows you to share a single server with multiple remote clients in order to play videogames!</p><p>Based on the <a href='ghcr.io/games-on-whales/wolf:stable' target='_blank'>official OCI image</a>, available for amd64 architecture only.</p>",
    "version": "3",
    "website": "https://games-on-whales.github.io/wolf/stable/index.html",
    "containers": {
      "Wolf": {
        "image": "ghcr.io/games-on-whales/wolf:stable",
        "tag": "stable",
        "launch_order": 1,
        "opts": [
            [
                "--network",
                "host"
            ]
        ],
        "volumes": {
          "/etc/wolf": {
            "description": "Choose a Share for all Wolf data.",
            "label": "Storage [e.g. wolf-all]"
          }
        },
        "devices": {
          "/dev/dri": {
            "description": "/dev/dri",
            "label": "GPU device"
          },
          "/dev/uinput": {
            "description": "/dev/uinput",
            "label": "User input device"
          },
          "/dev/uhid": {
            "description": "/dev/uhid",
            "label": "User HID device."
          }
        }
      }
    }
  }
}
